# Git Pipeline Server Configuration
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=7777
LOG_FILE=/home/user/git_pipeline_deploy.log

# HexTorq console event relay (optional)
# The pipeline reports deployment-started, deployment-log, and deployment-completed
# events to the local pipeline agent. Leave these blank to disable relay.
CONSOLE_AGENT_URL=http://127.0.0.1:9100
CONSOLE_AGENT_ID=agent-id-from-console
CONSOLE_AGENT_KEY=generated-agent-key

# Janahanlaw Project Configuration
JANAHANLAW_DIR=/home/user/web/janahanlaw.com/public_html/GIT/janahan-law
JANAHANLAW_SERVICE=Janahanlaw_Frontend

# Reservation Project Configuration (if enabled)
# RESERVATION_DIR=/home/user/web/reservation.dine360.ca/dine-360-reservation
# RESERVATION_PUBLIC=/home/user/web/reservation.dine360.ca/public_html
